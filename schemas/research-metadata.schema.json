{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1243353366/adversarial-code-reviewer-corpus/schemas/research-metadata.schema.json",
  "title": "Corpus research metadata",
  "description": "Per-document research metadata. JSON validity is not schema validity: this file is the contract, tools/validate_corpus.py enforces it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated",
    "generated_by",
    "corpus_purpose",
    "verification_policy",
    "documents",
    "corpus_level_observations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "generated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "generated_by": {
      "type": "string",
      "minLength": 3
    },
    "corpus_purpose": {
      "type": "string",
      "minLength": 10
    },
    "verification_policy": {
      "type": "object"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "corpus_level_observations": {
      "type": "object",
      "required": [
        "peer_review_tiers",
        "schema_enforcement"
      ],
      "properties": {
        "peer_review_tiers": {
          "type": "object",
          "required": [
            "publisher_confirmed",
            "manuscript_asserted",
            "secondary_source",
            "unreviewed"
          ],
          "additionalProperties": true,
          "properties": {
            "publisher_confirmed": {
              "$ref": "#/$defs/docIdList"
            },
            "manuscript_asserted": {
              "$ref": "#/$defs/docIdList"
            },
            "secondary_source": {
              "$ref": "#/$defs/docIdList"
            },
            "unreviewed": {
              "$ref": "#/$defs/docIdList"
            }
          }
        },
        "schema_enforcement": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "docId": {
      "type": "string",
      "pattern": "^D[0-9]+$"
    },
    "docIdList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/docId"
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "doc_id",
        "title",
        "authors",
        "publication_year",
        "document_type",
        "venue",
        "arxiv_id",
        "source_url",
        "license",
        "license_redistribution",
        "peer_review_tier",
        "peer_review_tier_basis",
        "reproducibility",
        "confidence_level",
        "evidence_status"
      ],
      "properties": {
        "doc_id": {
          "$ref": "#/$defs/docId"
        },
        "title": {
          "type": "string",
          "minLength": 8
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "publication_year": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100
        },
        "document_type": {
          "type": "string",
          "minLength": 3
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "doi_status": {
          "type": "string"
        },
        "arxiv_id": {
          "type": "string",
          "pattern": "^[0-9]{4}\\.[0-9]{4,5}$"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://arxiv\\.org/abs/[0-9]{4}\\.[0-9]{4,5}$"
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "version",
              "date"
            ],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^v[0-9]+$"
              },
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$"
              },
              "note": {
                "type": "string"
              },
              "date_precision": {
                "enum": [
                  "day",
                  "month"
                ]
              }
            }
          }
        },
        "license": {
          "type": "string",
          "minLength": 3
        },
        "license_redistribution": {
          "type": "string",
          "minLength": 3
        },
        "peer_review_tier": {
          "enum": [
            "publisher_confirmed",
            "manuscript_asserted",
            "secondary_source",
            "unreviewed"
          ]
        },
        "peer_review_tier_basis": {
          "type": "string",
          "minLength": 10
        },
        "reproducibility": {
          "$ref": "#/$defs/reproducibility"
        },
        "confidence_level": {
          "enum": [
            "high",
            "medium",
            "low",
            "unassessed"
          ]
        },
        "confidence": {
          "type": "object"
        },
        "evidence_status": {
          "enum": [
            "not_independently_verified",
            "partially_verified",
            "verified",
            "contradicted"
          ]
        },
        "artifacts": {
          "type": [
            "array",
            "null"
          ],
          "items": {},
          "description": "Domain field carried through from extraction."
        },
        "coverage_window": {
          "type": [
            "string",
            "null"
          ],
          "description": "Domain field carried through from extraction."
        },
        "datasets": {
          "type": [
            "object",
            "null"
          ],
          "description": "Domain field carried through from extraction."
        },
        "datasets_analyzed": {
          "type": [
            "string",
            "null"
          ],
          "description": "Domain field carried through from extraction."
        },
        "enumerated_limitations": {
          "type": [
            "array",
            "null"
          ],
          "items": {},
          "description": "Domain field carried through from extraction."
        },
        "key_contributions_extracted": {
          "type": [
            "array",
            "null"
          ],
          "items": {},
          "description": "Domain field carried through from extraction."
        },
        "methodology": {
          "type": [
            "array",
            "null"
          ],
          "items": {},
          "description": "Domain field carried through from extraction."
        },
        "negative_results": {
          "type": [
            "array",
            "null"
          ],
          "items": {},
          "description": "Domain field carried through from extraction."
        },
        "peer_review_status": {
          "type": [
            "string",
            "null"
          ],
          "description": "Domain field carried through from extraction."
        },
        "research_domain": {
          "type": [
            "array",
            "null"
          ],
          "items": {},
          "description": "Domain field carried through from extraction."
        },
        "results": {
          "type": [
            "object",
            "null"
          ],
          "description": "Domain field carried through from extraction."
        },
        "retained_for": {
          "type": [
            "string",
            "null"
          ],
          "description": "Domain field carried through from extraction."
        },
        "retraction_or_correction_status": {
          "type": [
            "string",
            "null"
          ],
          "description": "Domain field carried through from extraction."
        },
        "security_implications_noted_by_authors": {
          "type": [
            "string",
            "null"
          ],
          "description": "Domain field carried through from extraction."
        },
        "statistical_limitations": {
          "type": [
            "array",
            "null"
          ],
          "items": {},
          "description": "Domain field carried through from extraction."
        },
        "superseded_by": {
          "type": [
            "array",
            "null"
          ],
          "items": {},
          "description": "Domain field carried through from extraction."
        },
        "technical_architecture": {
          "type": [
            "array",
            "null"
          ],
          "items": {},
          "description": "Domain field carried through from extraction."
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_available",
        "search_strings_reported",
        "independently_replicated"
      ],
      "properties": {
        "code_available": {
          "enum": [
            "yes",
            "no",
            "unconfirmed",
            "not_stated"
          ]
        },
        "data_available": {
          "enum": [
            "yes",
            "no",
            "unconfirmed",
            "not_stated"
          ]
        },
        "search_strings_reported": {
          "enum": [
            "yes",
            "partially",
            "no",
            "not_stated"
          ]
        },
        "protocol_reported": {
          "type": "boolean"
        },
        "living_artifact_repo": {
          "enum": [
            "yes",
            "no",
            "not_stated"
          ]
        },
        "independently_replicated": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}